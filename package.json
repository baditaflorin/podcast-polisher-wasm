{
  "name": "podcast-polisher-wasm",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Browser-only podcast post-production with noise reduction, cleanup, and EBU R128 loudness normalization.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baditaflorin/podcast-polisher-wasm.git"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/clean-pages.mjs && tsc -b && vite build && node scripts/write-version.mjs && node scripts/copy-spa-fallback.mjs",
    "data": "node scripts/noop-data.mjs",
    "lint": "eslint . && prettier --check . && tsc -b --noEmit",
    "fmt": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "smoke": "bash scripts/smoke.sh",
    "pages-preview": "node scripts/pages-server.mjs 4173",
    "audit:high": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tanstack/react-query": "^5.100.9",
    "comlink": "^4.4.2",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
